# ========================================================
# 🐯 hodori_gjc & doribogo 환경 변수 설정 템플릿 (.env.example)
# 본 파일을 복사하여 '.env' 로 저장한 후 본인의 키를 입력하세요.
# ========================================================

# 1. Google Gemini API 키 (필수: https://aistudio.google.com/ 에서 무료 발급)
GEMINI_API_KEY=your_gemini_api_key_here

# 2. Discord 봇 및 웹후크 연동 (선택: https://discord.com/developers/applications)
DISCORD_BOT_TOKEN=your_discord_bot_token_here
DISCORD_CHANNEL_ID=your_discord_channel_id_here
DISCORD_WEBHOOK_URL=your_discord_webhook_url_here

# 3. Telegram 봇 연동 (선택: @BotFather 로 생성)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here
